+uint8_t clamp_byte(int value)
+{
+    return static_cast<uint8_t>(std::max(0, std::min(255, value)));
+}
+
+bool has_start_code(const uint8_t* data, size_t size)
+{
+    return size >= 4 && data[0] == 0 && data[1] == 0 &&
+           (data[2] == 1 || (data[2] == 0 && data[3] == 1));
+}
+
+void append_start_code_nal(std::vector<uint8_t>& output,
+                           const uint8_t* nal, size_t size)
+{
+    static const uint8_t start_code[] = {0, 0, 0, 1};
+    output.insert(output.end(), start_code, start_code + sizeof(start_code));
+    output.insert(output.end(), nal, nal + size);
+}
+
+bool avcc_to_annex_b(const uint8_t* data, size_t size,
+                     std::vector<uint8_t>& output)
+{
+    size_t offset = 0;
+    output.clear();
+    while (offset + 4 <= size) {
+        uint32_t nal_size = (static_cast<uint32_t>(data[offset]) << 24) |
+                            (static_cast<uint32_t>(data[offset + 1]) << 16) |
+                            (static_cast<uint32_t>(data[offset + 2]) << 8) |
+                            data[offset + 3];
+        offset += 4;
+        if (!nal_size || offset + nal_size > size) {
+            output.clear();
+            return false;
+        }
+        append_start_code_nal(output, data + offset, nal_size);
+        offset += nal_size;
+    }
+    return offset == size && !output.empty();
+}
+
+bool decoder_config_to_annex_b(const uint8_t* data, size_t size,
+                               std::vector<uint8_t>& output)
+{
+    output.clear();
+    if (has_start_code(data, size)) {
+        output.assign(data, data + size);
+        return true;
+    }
+    if (size < 7 || data[0] != 1)
+        return false;
+
+    size_t offset = 5;
+    unsigned int sps_count = data[offset++] & 0x1f;
+    for (unsigned int i = 0; i < sps_count; ++i) {
+        if (offset + 2 > size)
+            return false;
+        size_t nal_size = (data[offset] << 8) | data[offset + 1];
+        offset += 2;
+        if (!nal_size || offset + nal_size > size)
+            return false;
+        append_start_code_nal(output, data + offset, nal_size);
+        offset += nal_size;
+    }
+
+    if (offset >= size)
+        return false;
+    unsigned int pps_count = data[offset++];
+    for (unsigned int i = 0; i < pps_count; ++i) {
+        if (offset + 2 > size)
+            return false;
+        size_t nal_size = (data[offset] << 8) | data[offset + 1];
+        offset += 2;
+        if (!nal_size || offset + nal_size > size)
+            return false;
+        append_start_code_nal(output, data + offset, nal_size);
+        offset += nal_size;
+    }
+    return !output.empty();
+}
+
+bool contains_nal_type(const std::vector<uint8_t>& stream, uint8_t type)
+{
+    for (size_t i = 0; i + 4 < stream.size(); ++i) {
+        size_t nal = 0;
+        if (stream[i] == 0 && stream[i + 1] == 0 && stream[i + 2] == 1)
+            nal = i + 3;
+        else if (i + 4 < stream.size() && stream[i] == 0 &&
+                 stream[i + 1] == 0 && stream[i + 2] == 0 &&
+                 stream[i + 3] == 1)
+            nal = i + 4;
+        if (nal && nal < stream.size() && (stream[nal] & 0x1f) == type)
+            return true;
+    }
+    return false;
+}
