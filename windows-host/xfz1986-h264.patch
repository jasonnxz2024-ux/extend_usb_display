+int enc_h264::enc(uint8_t* dst, uint8_t* src, int x, int y, int right,
+                  int bottom, int line_width, int limit)
+{
+    if (x || y)
+        return -1;
+    UINT32 width = static_cast<UINT32>(right + 1);
+    UINT32 height = static_cast<UINT32>(bottom + 1);
+    if (impl_->width != width || impl_->height != height) {
+        HRESULT hr = impl_->initialize(width, height);
+        if (FAILED(hr)) {
+            LOGE("H264 encoder initialization failed: 0x%08x\n", hr);
+            return -1;
+        }
+    }
+    return impl_->encode(dst, src, static_cast<UINT32>(line_width) * 4U,
+                         limit);
+}
