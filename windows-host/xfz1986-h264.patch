+struct enc_h264::encoder_impl {
+    ComPtr<IMFTransform> transform;
+    std::vector<uint8_t> nv12;
+    std::vector<uint8_t> sequence_header;
+    std::vector<uint8_t> annex_b;
+    UINT32 width = 0;
+    UINT32 height = 0;
+    UINT32 fps = 30;
+    UINT32 bitrate = 4000000;
+    LONGLONG sample_time = 0;
+    bool mf_started = false;
+    bool com_started = false;
+    bool sent_parameter_sets = false;
+
+    encoder_impl(int bitrate_mbps, int requested_fps)
+    {
+        bitrate = static_cast<UINT32>(std::max(1, bitrate_mbps)) * 1000000U;
+        fps = static_cast<UINT32>(std::max(1, requested_fps));
+    }
+
+    ~encoder_impl()
+    {
+        shutdown();
+    }
+
+    void shutdown()
+    {
+        if (transform) {
+            transform->ProcessMessage(MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0);
+            transform->ProcessMessage(MFT_MESSAGE_COMMAND_FLUSH, 0);
+            transform.Reset();
+        }
+        if (mf_started) {
+            MFShutdown();
+            mf_started = false;
+        }
+        if (com_started) {
+            CoUninitialize();
+            com_started = false;
+        }
+        width = height = 0;
+        sample_time = 0;
+        sent_parameter_sets = false;
+        sequence_header.clear();
+    }
+
+    HRESULT set_codec_u32(const GUID& key, UINT32 value)
+    {
+        ComPtr<ICodecAPI> codec;
+        HRESULT hr = transform.As(&codec);
+        if (FAILED(hr))
+            return hr;
+        VARIANT setting;
+        VariantInit(&setting);
+        setting.vt = VT_UI4;
+        setting.ulVal = value;
+        return codec->SetValue(&key, &setting);
+    }
+
+    HRESULT initialize(UINT32 new_width, UINT32 new_height)
+    {
+        shutdown();
+        if ((new_width & 1U) || (new_height & 1U))
+            return E_INVALIDARG;
+
+        HRESULT hr = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+        if (SUCCEEDED(hr))
+            com_started = true;
+        else if (hr != RPC_E_CHANGED_MODE)
+            return hr;
+
+        hr = MFStartup(MF_VERSION, MFSTARTUP_LITE);
+        if (FAILED(hr))
+            return hr;
+        mf_started = true;
+
+        hr = CoCreateInstance(CLSID_CMSH264EncoderMFT, nullptr,
+                              CLSCTX_INPROC_SERVER,
+                              IID_PPV_ARGS(&transform));
+        if (FAILED(hr))
+            return hr;
+
+        ComPtr<IMFMediaType> output_type;
+        hr = MFCreateMediaType(&output_type);
+        if (FAILED(hr)) return hr;
+        if (FAILED(hr = output_type->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video))) return hr;
+        if (FAILED(hr = output_type->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_H264))) return hr;
+        if (FAILED(hr = output_type->SetUINT32(MF_MT_AVG_BITRATE, bitrate))) return hr;
+        if (FAILED(hr = output_type->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive))) return hr;
+        if (FAILED(hr = output_type->SetUINT32(MF_MT_MPEG2_PROFILE, eAVEncH264VProfile_Main))) return hr;
+        if (FAILED(hr = MFSetAttributeSize(output_type.Get(), MF_MT_FRAME_SIZE, new_width, new_height))) return hr;
+        if (FAILED(hr = MFSetAttributeRatio(output_type.Get(), MF_MT_FRAME_RATE, fps, 1))) return hr;
+        if (FAILED(hr = MFSetAttributeRatio(output_type.Get(), MF_MT_PIXEL_ASPECT_RATIO, 1, 1))) return hr;
+        if (FAILED(hr = transform->SetOutputType(0, output_type.Get(), 0))) return hr;
+
+        ComPtr<IMFMediaType> input_type;
+        hr = MFCreateMediaType(&input_type);
+        if (FAILED(hr)) return hr;
+        if (FAILED(hr = input_type->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video))) return hr;
+        if (FAILED(hr = input_type->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_NV12))) return hr;
+        if (FAILED(hr = input_type->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive))) return hr;
+        if (FAILED(hr = MFSetAttributeSize(input_type.Get(), MF_MT_FRAME_SIZE, new_width, new_height))) return hr;
+        if (FAILED(hr = MFSetAttributeRatio(input_type.Get(), MF_MT_FRAME_RATE, fps, 1))) return hr;
+        if (FAILED(hr = MFSetAttributeRatio(input_type.Get(), MF_MT_PIXEL_ASPECT_RATIO, 1, 1))) return hr;
+        if (FAILED(hr = transform->SetInputType(0, input_type.Get(), 0))) return hr;
+
+        set_codec_u32(CODECAPI_AVEncCommonRateControlMode,
+                      eAVEncCommonRateControlMode_LowDelayVBR);
+        set_codec_u32(CODECAPI_AVEncCommonMeanBitRate, bitrate);
+        set_codec_u32(CODECAPI_AVEncMPVGOPSize, fps * 2);
+        set_codec_u32(CODECAPI_AVLowLatencyMode, TRUE);
+
+        if (FAILED(hr = transform->ProcessMessage(MFT_MESSAGE_COMMAND_FLUSH, 0))) return hr;
+        if (FAILED(hr = transform->ProcessMessage(MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0))) return hr;
+        if (FAILED(hr = transform->ProcessMessage(MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0))) return hr;
+
+        width = new_width;
+        height = new_height;
+        nv12.resize(static_cast<size_t>(width) * height * 3 / 2);
+        LOGI("H264 encoder ready: %ux%u %u fps %u bps\n",
+             width, height, fps, bitrate);
+        return S_OK;
+    }
+
+    void bgra_to_nv12(const uint8_t* bgra, UINT32 stride)
+    {
+        uint8_t* y_plane = nv12.data();
+        uint8_t* uv_plane = y_plane + static_cast<size_t>(width) * height;
+        for (UINT32 y = 0; y < height; ++y) {
+            const uint8_t* row = bgra + static_cast<size_t>(y) * stride;
+            for (UINT32 x = 0; x < width; ++x) {
+                int b = row[x * 4];
+                int g = row[x * 4 + 1];
+                int r = row[x * 4 + 2];
+                y_plane[static_cast<size_t>(y) * width + x] =
+                    clamp_byte(((66 * r + 129 * g + 25 * b + 128) >> 8) + 16);
+            }
+        }
+        for (UINT32 y = 0; y < height; y += 2) {
+            const uint8_t* row0 = bgra + static_cast<size_t>(y) * stride;
+            const uint8_t* row1 = bgra + static_cast<size_t>(y + 1) * stride;
+            for (UINT32 x = 0; x < width; x += 2) {
+                int b = row0[x * 4] + row0[(x + 1) * 4] +
+                        row1[x * 4] + row1[(x + 1) * 4];
+                int g = row0[x * 4 + 1] + row0[(x + 1) * 4 + 1] +
+                        row1[x * 4 + 1] + row1[(x + 1) * 4 + 1];
+                int r = row0[x * 4 + 2] + row0[(x + 1) * 4 + 2] +
+                        row1[x * 4 + 2] + row1[(x + 1) * 4 + 2];
+                r >>= 2; g >>= 2; b >>= 2;
+                size_t uv = static_cast<size_t>(y / 2) * width + x;
+                uv_plane[uv] = clamp_byte(((-38 * r - 74 * g + 112 * b + 128) >> 8) + 128);
+                uv_plane[uv + 1] = clamp_byte(((112 * r - 94 * g - 18 * b + 128) >> 8) + 128);
+            }
+        }
+    }
+
+    void update_sequence_header()
+    {
+        ComPtr<IMFMediaType> type;
+        if (FAILED(transform->GetOutputCurrentType(0, &type)))
+            return;
+        UINT32 size = 0;
+        if (FAILED(type->GetBlobSize(MF_MT_MPEG_SEQUENCE_HEADER, &size)) || !size)
+            return;
+        std::vector<uint8_t> config(size);
+        if (FAILED(type->GetBlob(MF_MT_MPEG_SEQUENCE_HEADER, config.data(),
+                                 size, &size)))
+            return;
+        decoder_config_to_annex_b(config.data(), size, sequence_header);
+    }
+
+    int encode(uint8_t* dst, const uint8_t* bgra, UINT32 source_stride,
+               int limit)
+    {
+        bgra_to_nv12(bgra, source_stride);
+
+        ComPtr<IMFMediaBuffer> input_buffer;
+        HRESULT hr = MFCreateMemoryBuffer(static_cast<DWORD>(nv12.size()),
+                                          &input_buffer);
+        if (FAILED(hr)) return -1;
+        BYTE* input = nullptr;
+        DWORD capacity = 0;
+        if (FAILED(hr = input_buffer->Lock(&input, &capacity, nullptr))) return -1;
+        memcpy(input, nv12.data(), nv12.size());
+        input_buffer->Unlock();
+        input_buffer->SetCurrentLength(static_cast<DWORD>(nv12.size()));
+
+        ComPtr<IMFSample> input_sample;
+        if (FAILED(hr = MFCreateSample(&input_sample))) return -1;
+        if (FAILED(hr = input_sample->AddBuffer(input_buffer.Get()))) return -1;
+        LONGLONG duration = 10000000LL / fps;
+        input_sample->SetSampleTime(sample_time);
+        input_sample->SetSampleDuration(duration);
+        sample_time += duration;
+        if (FAILED(hr = transform->ProcessInput(0, input_sample.Get(), 0))) {
+            LOGE("H264 ProcessInput failed: 0x%08x\n", hr);
+            return -1;
+        }
+
+        MFT_OUTPUT_STREAM_INFO info = {};
+        if (FAILED(hr = transform->GetOutputStreamInfo(0, &info))) return -1;
+        MFT_OUTPUT_DATA_BUFFER output = {};
+        ComPtr<IMFSample> output_sample;
+        if (!(info.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES)) {
+            ComPtr<IMFMediaBuffer> output_buffer;
+            DWORD buffer_size = static_cast<DWORD>(std::max<int>(limit, info.cbSize));
+            if (FAILED(hr = MFCreateMemoryBuffer(buffer_size, &output_buffer))) return -1;
+            if (FAILED(hr = MFCreateSample(&output_sample))) return -1;
+            if (FAILED(hr = output_sample->AddBuffer(output_buffer.Get()))) return -1;
+            output.pSample = output_sample.Get();
+        }
+
+        DWORD status = 0;
+        hr = transform->ProcessOutput(0, 1, &output, &status);
+        if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT)
+            return 0;
+        if (hr == MF_E_TRANSFORM_STREAM_CHANGE) {
+            LOGW("H264 encoder requested an output stream change\n");
+            return 0;
+        }
+        if (FAILED(hr)) {
+            LOGE("H264 ProcessOutput failed: 0x%08x\n", hr);
+            return -1;
+        }
+
+        IMFSample* produced = output.pSample;
+        if (!produced)
+            return 0;
+        ComPtr<IMFMediaBuffer> contiguous;
+        if (FAILED(hr = produced->ConvertToContiguousBuffer(&contiguous))) return -1;
+        BYTE* encoded = nullptr;
+        DWORD encoded_size = 0;
+        if (FAILED(hr = contiguous->Lock(&encoded, nullptr, &encoded_size))) return -1;
+
+        if (has_start_code(encoded, encoded_size))
+            annex_b.assign(encoded, encoded + encoded_size);
+        else if (!avcc_to_annex_b(encoded, encoded_size, annex_b)) {
+            contiguous->Unlock();
+            LOGE("H264 output is neither Annex-B nor 4-byte AVCC\n");
+            return -1;
+        }
+        contiguous->Unlock();
+
+        if (sequence_header.empty())
+            update_sequence_header();
+        bool idr = contains_nal_type(annex_b, 5);
+        bool has_sps = contains_nal_type(annex_b, 7);
+        size_t prefix = ((!sent_parameter_sets || idr) && !has_sps) ?
+                        sequence_header.size() : 0;
+        if (prefix + annex_b.size() > static_cast<size_t>(limit)) {
+            LOGE("H264 access unit too large: %zu > %d\n",
+                 prefix + annex_b.size(), limit);
+            return -1;
+        }
+        if (prefix)
+            memcpy(dst, sequence_header.data(), prefix);
+        memcpy(dst + prefix, annex_b.data(), annex_b.size());
+        if (has_sps || prefix)
+            sent_parameter_sets = true;
+        return static_cast<int>(prefix + annex_b.size());
+    }
+};
+
+enc_h264::enc_h264(int bitrate_mbps, int fps)
+    : impl_(new encoder_impl(bitrate_mbps, fps))
+{
+    enc_type = UDISP_TYPE_H264;
+}
+
+enc_h264::~enc_h264()
+{
+    delete impl_;
+}
